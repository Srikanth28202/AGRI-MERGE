# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Get a free OpenRouter key at: https://openrouter.ai/keys

# Required for AI-powered chatbot responses (without it, rule-based fallback is used)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# ---------------------------------------------------------------------------
# Farmer Message Alert System
# ---------------------------------------------------------------------------
# Leave the TWILIO_* values blank to use the built-in console/demo SMS provider
# (messages are written to the backend log instead of being sent for real).
# To enable REAL SMS (e.g. for the demo), create a free Twilio trial account
# at https://www.twilio.com and fill these in:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
