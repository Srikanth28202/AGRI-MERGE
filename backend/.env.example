# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Get a free OpenRouter key at: https://openrouter.ai/keys
#
# If the chatbot replies with "OpenRouter API error: 401", the key is invalid,
# expired or revoked - generate a new one. Without a working key the chatbot
# still answers, but every reply comes from the rule-based fallback.

# Required for AI-powered chatbot responses (without it, rule-based fallback is used)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model. Browse current ids at
# https://openrouter.ai/models - only ':free' ids ending in ':free' are free.
# Avoid reasoning-only models (they return null content).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------------
# Farmer Message Alert System
# ---------------------------------------------------------------------------
# Provider priority: CallMeBot (WhatsApp) > Fast2SMS (SMS) > Twilio (SMS) >
# console (demo log). Leave everything blank to use the console/demo provider
# (messages are written to the backend log instead of being sent for real).

# --- Fast2SMS "Quick SMS" (India, no DLT) ----------------------------------
# Sign up free at https://www.fast2sms.com and copy the key from the Dev API
# section. Quick SMS route works without DLT registration; free test credits.
FAST2SMS_API_KEY=

# --- CallMeBot free WhatsApp API (personal use) ----------------------------
# Delivers ONLY to the number that activated the API key. Activation:
#   1. Add the bot number +34 644 20 47 56 to your WhatsApp contacts.
#   2. Send it the text: I allow callmebot to send me messages
#   3. You get a reply with your APIKEY; put it below (and your own number).
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# --- Twilio SMS (paid, reliable) -------------------------------------------
# To enable REAL SMS create a trial account at https://www.twilio.com:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
